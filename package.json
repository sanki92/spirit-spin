{
  "name": "spirit-spin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "balance": "npm run balance -w @spirit/core",
    "proto": "protoc -I proto --go_out=edge/gen/edgev1 --go_opt=paths=source_relative --go-grpc_out=edge/gen/edgev1 --go-grpc_opt=paths=source_relative proto/edge.proto",
    "edge": "cd edge && go run ./cmd/edge",
    "edge:test": "cd edge && go test -race ./...",
    "edge:build": "cd edge && go build -trimpath -o ../dist/edge ./cmd/edge"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
